    <!-- Leaflet JS -->
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
    ></script>

    <script type="text/javascript">
      (function () {
        // In order, with arrows from first to last.
        // [title, lat, lng, url]
        var locations = [
          ["Carmel, California", 36.555241, -121.923286, "../../../americas/usa/ca/carmel.html"],
          ["Soledad, California", 36.424721, -121.326385, "../../../americas/usa/ca/soledad.html"],
          ["Fort Hunter Liggett, California", 35.9522, -121.2306, "../../../americas/usa/ca/fort-hunter-liggett.html"],
          ["Chinese Camp, California", 37.86883, -120.43350, "../../../americas/usa/ca/chinese-camp.html"],
          ["Jamestown, California", 37.9550, -120.4053, "../../../americas/usa/ca/jamestown.html"],
          ["Columbia, California", 38.033667, -120.400664, "../../../americas/usa/ca/columbia.html"],
          ["Angels Camp, California", 38.067783, -120.538528, "../../../americas/usa/ca/angels-camp.html"],
          ["Isleton, California", 38.157167, -121.605497, "../../../americas/usa/ca/isleton.html"],
          ["Locke, California", 38.250333, -121.505664, "../../../americas/usa/ca/locke.html"],
          ["Placerville, California", 38.729626, -120.798546, "../../../americas/usa/ca/placerville.html"],
          ["Coloma, California", 38.8025, -120.894719, "../../../americas/usa/ca/coloma.html"]
        ];

        // Green start marker (first stop)
        var greenIcon = L.icon({
          iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png",
          shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
          iconSize: [25, 41],
          iconAnchor: [12, 41],
          popupAnchor: [1, -34],
          shadowSize: [41, 41]
        });

        // ---- Arrow helpers (StackOverflow-style) ----
        function Point(x, y, round) {
          this.x = (round ? Math.round(x) : x);
          this.y = (round ? Math.round(y) : y);
        }
        function distanceTo(p1, p2) {
          var x = p2.x - p1.x, y = p2.y - p1.y;
          return Math.sqrt(x * x + y * y);
        }
        function myMidPoint(latlng1, latlng2, per, mapObj) {
          var p1 = mapObj.project(new L.latLng(latlng1));
          var p2 = mapObj.project(new L.latLng(latlng2));
          var halfDist = distanceTo(p1, p2) * per;
          if (halfDist === 0) return mapObj.unproject(p1);

          var dist = distanceTo(p1, p2);
          if (dist > halfDist) {
            var ratio = (dist - halfDist) / dist;
            var res = mapObj.unproject(
              new Point(
                p2.x - ratio * (p2.x - p1.x),
                p2.y - ratio * (p2.y - p1.y)
              )
            );
            return [res.lat, res.lng];
          }
        }
        function getAngle(latLng1, latlng2, coef) {
          var dy = latlng2[0] - latLng1[0];
          var dx = Math.cos(Math.PI / 180 * latLng1[0]) * (latlng2[1] - latLng1[1]);
          var ang = ((Math.atan2(dy, dx) / Math.PI) * 180 * coef);
          return (+ang).toFixed(2);
        }
        function getArrows(arrLatlngs, color, arrowCount, mapObj) {
          if (!arrLatlngs || arrLatlngs.length < 2) return [];
          if (arrowCount == null) arrowCount = 1;

          var styleColor = color ? "color:" + color : "";
          var result = [];

          for (var i = 1; i < arrLatlngs.length; i++) {
            var icon = L.divIcon({
              className: "arrow-icon",
              html:
                '<div style="' +
                styleColor +
                ';transform: rotate(' +
                getAngle(arrLatlngs[i - 1], arrLatlngs[i], -1) +
                'deg)">▶</div>'
            });

            for (var c = 1; c <= arrowCount; c++) {
              var pt = myMidPoint(arrLatlngs[i], arrLatlngs[i - 1], (c / (arrowCount + 1)), mapObj);
              if (pt) result.push(L.marker(pt, { icon: icon, interactive: false }));
            }
          }
          return result;
        }

        function initLeafletTripMap() {
          if (typeof L === "undefined") return;

          var mapEl = document.getElementById("map");
          if (!mapEl) return;

          var map = L.map(mapEl, { scrollWheelZoom: true });

          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: "&copy; OpenStreetMap contributors"
          }).addTo(map);

          var markerGroup = L.featureGroup().addTo(map);

          for (var i = 0; i < locations.length; i++) {
            var title = locations[i][0];
            var lat = locations[i][1];
            var lng = locations[i][2];
            var url = locations[i][3];

            var popupHTML = url
              ? '<a href="' + url + '" target="_blank" rel="noopener">' + title + "</a>"
              : title;

            var opts = (i === 0) ? { icon: greenIcon } : undefined;

            L.marker([lat, lng], opts).addTo(markerGroup).bindPopup(popupHTML);
          }

          // Route (OPEN, not a closed loop): first -> last
          var routeLatLngs = locations.map(function (p) { return [p[1], p[2]]; });

          var routeLine = L.polyline(routeLatLngs, {
            color: "#000000",
            weight: 2,
            opacity: 1.0
          }).addTo(map);

          // Arrows: 2 per segment
          var arrows = getArrows(routeLatLngs, "#000000", 2, map);
          L.featureGroup(arrows).addTo(map);

          map.fitBounds(routeLine.getBounds(), { padding: [30, 30] });

          // Webflow sizing fix
          setTimeout(function () { map.invalidateSize(); }, 250);
          setTimeout(function () { map.invalidateSize(); }, 1000);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initLeafletTripMap);
        } else {
          initLeafletTripMap();
        }
      })();
    </script>
  </div>

