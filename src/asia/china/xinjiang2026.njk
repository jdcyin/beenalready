  <script type="text/javascript">
    (function () {
      /*
        Add points in travel order.

        pointType:
          - "start"    = green marker, start of the connected route
          - "via"      = yellow marker, a stop along the connected route
          - "end"      = red marker, end of the connected route
          - "separate" = blue marker -- shown on the map but not part of
                          the connected route: no line drawn to/from it,
                          and it doesn't affect the map's default zoom.
                          Used here for Ürümqi, since it's a separate
                          endpoint far from the Kashgar-area stops.

        lineFromPrevious:
          - "solid"
          - "dotted"

        The first point does not need lineFromPrevious. Points with
        pointType "separate" don't need it either.

        More stops will be added as the itinerary firms up -- only
        confirmed places get a marker.
      */

      var locations = [
        {
          city: "Kashgar (喀什)",
          lat: 39.4666,
          lng: 75.99,
          pointType: "start",
          posts: [
            { label: "Day 1: Kashgar (喀什)", url: "xinjiang2026_01.html" },
            { label: "Day 6: Kashgar Museum, Xiangfei Yuan, Old Town West", url: "xinjiang2026_06.html" }
          ]
        },
        {
          city: "Ao-i-ta-ke Red Rocks (奧依塔克紅山口)",
          lat: 38.9476,
          lng: 75.4949,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 2: Ao-i-ta-ke Red Rocks (奧依塔克紅山口)", url: "xinjiang2026_02.html" }
          ]
        },
        {
          city: "Baisha Lake (布倫庫勒水庫)",
          lat: 38.7203,
          lng: 74.9863,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 2: Baisha Lake (布倫庫勒水庫)", url: "xinjiang2026_02.html" }
          ]
        },
        {
          city: "Muji Volcano (木吉火山口)",
          lat: 39.0015,
          lng: 74.5006,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 2: Muji Volcano (木吉火山口)", url: "xinjiang2026_02.html" }
          ]
        },
        {
          city: "Subashi Village (蘇巴什村)",
          lat: 38.4194,
          lng: 75.0662,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 2: Subashi Village (蘇巴什村)", url: "xinjiang2026_02.html" }
          ]
        },
        {
          city: "Panlong Road (盤龍古道)",
          lat: 37.6287,
          lng: 75.4542,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 3: Panlong Road (盤龍古道)", url: "xinjiang2026_03.html" }
          ]
        },
        {
          city: "Bandier Lake (班迪爾藍湖)",
          lat: 37.838,
          lng: 75.4218,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 3: Bandier Lake (班迪爾藍湖)", url: "xinjiang2026_03.html" }
          ]
        },
        {
          city: "Pamir's Eye (帕米爾之眼)",
          lat: 37.8603,
          lng: 75.3077,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 3: Pamir's Eye (帕米爾之眼)", url: "xinjiang2026_03.html" }
          ]
        },
        {
          city: "Tashkurgan (塔什庫爾干)",
          lat: 37.7769,
          lng: 75.2247,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 3: Tashkurgan (塔什庫爾干)", url: "xinjiang2026_03.html" }
          ]
        },
        {
          city: "Tuogelun Village (托格倫夏村)",
          lat: 37.995,
          lng: 75.14,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 4: Tuogelun Village (托格倫夏村)", url: "xinjiang2026_04.html" }
          ]
        },
        {
          city: "Treehole Road (樹洞公路)",
          lat: 37.9868,
          lng: 75.1292,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 4: Treehole Road (樹洞公路)", url: "xinjiang2026_04.html" }
          ]
        },
        {
          city: "Bahe Bazaar (巴合齊鄉巴札)",
          lat: 39.3163,
          lng: 76.0094,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 4: Bahe Bazaar (巴合齊鄉巴札)", url: "xinjiang2026_04.html" }
          ]
        },
        {
          // Closes the Day 4 loop back to Kashgar -- same coordinates as
          // the starting marker, so it sits right on top of it. It carries
          // the same popup links, since this copy is the one that receives
          // the click.
          city: "Kashgar (喀什)",
          lat: 39.4666,
          lng: 75.99,
          pointType: "start",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 1: Kashgar (喀什)", url: "xinjiang2026_01.html" },
            { label: "Day 6: Kashgar Museum, Xiangfei Yuan, Old Town West", url: "xinjiang2026_06.html" }
          ]
        },
        {
          city: "Shache (莎車)",
          lat: 38.417,
          lng: 77.2411,
          pointType: "via",
          lineFromPrevious: "solid",
          posts: [
            { label: "Day 5: Shache (莎車)", url: "xinjiang2026_05.html" }
          ]
        },
        {
          city: "Ürümqi (烏魯木齊)",
          lat: 43.8256,
          lng: 87.6168,
          pointType: "separate",
          posts: [
            { label: "Day 7: Kashgar to Ürümqi (travel day)", url: "xinjiang2026_07.html" },
            { label: "Day 8: Ürümqi (烏魯木齊)", url: "xinjiang2026_08.html" }
          ]
        }
      ];

      var greenIcon = L.icon({
        iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png",
        shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
      });

      var redIcon = L.icon({
        iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png",
        shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
      });

      var blueIcon = L.icon({
        iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png",
        shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
      });

      var yellowIcon = L.icon({
        iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-yellow.png",
        shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
      });

      function Point(x, y, round) {
        this.x = round ? Math.round(x) : x;
        this.y = round ? Math.round(y) : y;
      }

      function distanceTo(p1, p2) {
        var x = p2.x - p1.x;
        var y = p2.y - p1.y;
        return Math.sqrt(x * x + y * y);
      }

      function pointAlongLine(startLatLng, endLatLng, per, mapObj) {
        var p1 = mapObj.project(new L.latLng(startLatLng));
        var p2 = mapObj.project(new L.latLng(endLatLng));

        var x = p1.x + (p2.x - p1.x) * per;
        var y = p1.y + (p2.y - p1.y) * per;

        var res = mapObj.unproject(new Point(x, y));
        return [res.lat, res.lng];
      }

      function getAngle(latLng1, latLng2, coef) {
        var dy = latLng2[0] - latLng1[0];
        var dx = Math.cos(Math.PI / 180 * latLng1[0]) * (latLng2[1] - latLng1[1]);
        var ang = (Math.atan2(dy, dx) / Math.PI) * 180 * coef;
        return (+ang).toFixed(2);
      }

      function buildPopup(cityName, posts) {
        if (!posts || !posts.length) {
          return '<div class="popup-title">' + cityName + '</div>';
        }

        var list = posts.map(function (post) {
          return (
            '<li><a href="' +
            post.url +
            '" target="_blank" rel="noopener">' +
            post.label +
            '</a></li>'
          );
        }).join('');

        return (
          '<div class="popup-title">' +
          cityName +
          '</div>' +
          '<ul class="popup-links">' +
          list +
          '</ul>'
        );
      }

      function getIcon(pointType) {
        if (pointType === "start") return greenIcon;
        if (pointType === "via") return yellowIcon;
        if (pointType === "separate") return blueIcon;
        return redIcon;
      }

      function addArrowMarkers(map, startLatLng, endLatLng, arrowCount, color) {
        if (!arrowCount) arrowCount = 2;
        if (!color) color = "#000000";

        var angle = getAngle(startLatLng, endLatLng, -1);

        var icon = L.divIcon({
          className: "arrow-icon",
          html: '<div style="color:' + color + ';transform: rotate(' + angle + 'deg)">▶</div>'
        });

        var arrows = [];

        for (var i = 1; i <= arrowCount; i++) {
          var pt = pointAlongLine(startLatLng, endLatLng, i / (arrowCount + 1), map);
          arrows.push(
            L.marker(pt, {
              icon: icon,
              interactive: false
            }).addTo(map)
          );
        }

        return arrows;
      }

      function drawSegment(map, fromLoc, toLoc) {
        var style = toLoc.lineFromPrevious || "solid";
        var startLatLng = [fromLoc.lat, fromLoc.lng];
        var endLatLng = [toLoc.lat, toLoc.lng];

        var options = {
          color: "#000000",
          weight: 2,
          opacity: 1
        };

        if (style === "dotted") {
          options.dashArray = "4, 8";
        }

        var line = L.polyline([startLatLng, endLatLng], options).addTo(map);
        var arrows = addArrowMarkers(map, startLatLng, endLatLng, 2, "#000000");

        return {
          line: line,
          arrows: arrows
        };
      }

      function initLeafletTripMap() {
        var mapEl = document.getElementById("map");
        if (!mapEl || typeof L === "undefined" || !locations.length) return;

        var map = L.map(mapEl, { scrollWheelZoom: true });

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);

        // "separate" markers (e.g. a far-off endpoint like Ürümqi that isn't
        // part of the connected Kashgar-area route) still show on the map,
        // but don't drive the zoom/bounds and don't get a route line.
        var boundsGroup = L.featureGroup().addTo(map);
        var routeLocations = locations.filter(function (loc) {
          return loc.pointType !== "separate";
        });

        locations.forEach(function (loc) {
          var marker = L.marker([loc.lat, loc.lng], {
            icon: getIcon(loc.pointType)
          }).addTo(map);

          if (loc.posts && loc.posts.length) {
            marker.bindPopup(buildPopup(loc.city, loc.posts));
          } else if (loc.label) {
            // Plain place-name popup, shown only on click -- no link, just the label.
            marker.bindPopup('<div class="popup-title">' + loc.label + '</div>');
          }

          if (loc.pointType !== "separate") {
            boundsGroup.addLayer(marker);
          }
        });

        for (var i = 1; i < routeLocations.length; i++) {
          var segment = drawSegment(map, routeLocations[i - 1], routeLocations[i]);
          boundsGroup.addLayer(segment.line);
        }

        if (routeLocations.length > 1) {
          map.fitBounds(boundsGroup.getBounds(), { padding: [30, 30] });
        } else if (routeLocations.length === 1) {
          map.setView([routeLocations[0].lat, routeLocations[0].lng], 10);
        } else {
          map.fitBounds(L.featureGroup(locations.map(function (loc) {
            return L.marker([loc.lat, loc.lng]);
          })).getBounds(), { padding: [30, 30] });
        }

        setTimeout(function () { map.invalidateSize(); }, 250);
        setTimeout(function () { map.invalidateSize(); }, 1000);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLeafletTripMap);
      } else {
        initLeafletTripMap();
      }
    })();
  </script>
