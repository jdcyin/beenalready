  <script>
    (function () {
      // [markerTitle, lat, lng, [ {label, url}, ... ] ]
      var locations = [
        ["Dalian", 38.914003, 121.614682, [
          { label: "Day 1: Dalian", url: "../../asia/china/dalian.html" },
          { label: "Day 2: Dalian", url: "../../asia/china/dalian2.html" },
          { label: "Day 3: Dalian", url: "../../asia/china/dalian3.html" },
          { label: "Days 14 & 15: Dalian", url: "../../asia/china/dalian4.html" }
        ]],

        ["Shenyang", 41.805699, 123.431472, [
          { label: "Day 4: Shenyang", url: "../../asia/china/shenyang.html" },
          { label: "Day 6: Shenyang", url: "../../asia/china/shenyang2.html" },
          { label: "Day 7: Shenyang", url: "../../asia/china/shenyang3.html" },
          { label: "Days 12 & 13: Shenyang", url: "../../asia/china/shenyang4.html" }
        ]],

        ["Dandong", 40.000787, 124.354451, [
          { label: "Day 5: Dandong", url: "../../asia/china/dandong.html" }
        ]],

        ["Harbin", 45.803775, 126.534967, [
          { label: "Day 8: Harbin", url: "../../asia/china/harbin.html" },
          { label: "Day 9: Harbin", url: "../../asia/china/harbin2.html" },
          { label: "Day 10: Harbin", url: "../../asia/china/harbin3.html" }
        ]]
      ];

      // Green start marker (Dalian)
      var greenIcon = L.icon({
        iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png",
        shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
      });

      // ---- Arrow helpers ----
      function Point(x, y, round) { this.x = (round ? Math.round(x) : x); this.y = (round ? Math.round(y) : y); }
      function distanceTo(p1, p2) { var x = p2.x - p1.x, y = p2.y - p1.y; return Math.sqrt(x*x + y*y); }
      function myMidPoint(latlng1, latlng2, per, mapObj) {
        var p1 = mapObj.project(new L.latLng(latlng1));
        var p2 = mapObj.project(new L.latLng(latlng2));
        var halfDist = distanceTo(p1, p2) * per;
        if (halfDist === 0) return mapObj.unproject(p1);
        var dist = distanceTo(p1, p2);
        if (dist > halfDist) {
          var ratio = (dist - halfDist) / dist;
          var res = mapObj.unproject(new Point(
            p2.x - ratio * (p2.x - p1.x),
            p2.y - ratio * (p2.y - p1.y)
          ));
          return [res.lat, res.lng];
        }
      }
      function getAngle(latLng1, latlng2, coef) {
        var dy = latlng2[0] - latLng1[0];
        var dx = Math.cos(Math.PI / 180 * latLng1[0]) * (latlng2[1] - latLng1[1]);
        var ang = ((Math.atan2(dy, dx) / Math.PI) * 180 * coef);
        return (+ang).toFixed(2);
      }
      function getArrows(arrLatlngs, color, arrowCount, mapObj) {
        if (!arrLatlngs || arrLatlngs.length < 2) return [];
        if (arrowCount == null) arrowCount = 1;

        var styleColor = color ? "color:" + color : "";
        var result = [];

        for (var i = 1; i < arrLatlngs.length; i++) {
          var icon = L.divIcon({
            className: "arrow-icon",
            html: '<div style="' + styleColor + ';transform: rotate(' +
              getAngle(arrLatlngs[i - 1], arrLatlngs[i], -1) +
              'deg)">▶</div>'
          });

          for (var c = 1; c <= arrowCount; c++) {
            var pt = myMidPoint(arrLatlngs[i], arrLatlngs[i - 1], (c / (arrowCount + 1)), mapObj);
            if (pt) result.push(L.marker(pt, { icon: icon, interactive: false }));
          }
        }
        return result;
      }

      function buildPopup(title, links) {
        if (!links || !links.length) return '<div class="popup-title">' + title + "</div>";

        // Sort by day number where possible so it feels consistent
        var sorted = links.slice().sort(function(a, b){
          function dayNum(label){
            var m = label.match(/Day\s+(\d+)/i);
            return m ? parseInt(m[1], 10) : 9999;
          }
          return dayNum(a.label) - dayNum(b.label);
        });

        var list = sorted.map(function (l) {
          return '<li><a href="' + l.url + '" target="_blank" rel="noopener">' + l.label + "</a></li>";
        }).join("");

        return '<div class="popup-title">' + title + '</div><ul class="popup-links">' + list + "</ul>";
      }

      function initLeafletTripMap() {
        var mapEl = document.getElementById("map");
        if (!mapEl || typeof L === "undefined") return;

        var map = L.map(mapEl, { scrollWheelZoom: true });

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);

        // Markers
        for (var i = 0; i < locations.length; i++) {
          var title = locations[i][0];
          var lat = locations[i][1];
          var lng = locations[i][2];
          var links = locations[i][3];

          var popupHTML = buildPopup(title, links);
          var markerOpts = (title === "Dalian") ? { icon: greenIcon } : undefined;

          L.marker([lat, lng], markerOpts).addTo(map).bindPopup(popupHTML);
        }

        // Route path (same order as your original Google path)
        var routeLatLngs = [
          [38.914003, 121.614682], // Dalian
          [41.805699, 123.431472], // Shenyang
          [40.000787, 124.354451], // Dandong
          [41.805699, 123.431472], // Shenyang (back)
          [45.803775, 126.534967]  // Harbin
        ];

        var routeLine = L.polyline(routeLatLngs, {
          color: "#000000",
          weight: 2,
          opacity: 1.0
        }).addTo(map);

        // Arrows (2 per segment)
        var arrows = getArrows(routeLatLngs, "#000000", 2, map);
        L.featureGroup(arrows).addTo(map);

        map.fitBounds(routeLine.getBounds(), { padding: [30, 30] });

        // Webflow sizing fix
        setTimeout(function () { map.invalidateSize(); }, 250);
        setTimeout(function () { map.invalidateSize(); }, 1000);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLeafletTripMap);
      } else {
        initLeafletTripMap();
      }
    })();
  </script>
